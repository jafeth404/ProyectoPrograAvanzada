@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="authentication-wrapper authentication-basic">
        <div class="authentication-inner">

            <!-- 🔥 CARD -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- 🔥 LOGO / TITULO -->
                    <div class="text-center mb-4">
                        <i class="bx bx-restaurant text-primary" style="font-size: 60px;"></i>
                        <h4 class="mt-2 fw-bold">RestauranteApp</h4>
                        <p class="text-muted">Inicia sesión para continuar</p>
                    </div>

                    <!-- 🔥 FORM -->
                    <form id="account" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- EMAIL -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control"
                                       placeholder="correo@ejemplo.com" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control"
                                       placeholder="••••••••" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <!-- REMEMBER -->
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">
                                    Recordarme
                                </label>
                            </div>

                            <a id="forgot-password" asp-page="./ForgotPassword" class="small">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <!-- BOTON -->
                        <div class="mb-3">
                            <button id="login-submit" type="submit" class="btn btn-primary w-100">
                                <i class="bx bx-log-in-circle me-1"></i> Iniciar Sesión
                            </button>
                        </div>

                        <!-- REGISTER -->
                        <p class="text-center">
                            ¿No tienes cuenta?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                                Crear cuenta
                            </a>
                        </p>

                    </form>

                    <!-- 🔥 DIVIDER -->
                    <div class="divider my-4">
                        <div class="divider-text">o continúa con</div>
                    </div>

                    <!-- 🔥 LOGIN EXTERNO -->
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <form id="external-account"
                                  asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  method="post">

                                <div class="d-flex flex-wrap gap-2 justify-content-center">

                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit"
                                                class="btn btn-outline-primary"
                                                name="provider"
                                                value="@provider.Name">

                                            <i class="bx bx-user-circle me-1"></i>
                                            @provider.DisplayName
                                        </button>
                                    }

                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center text-muted small">
                                No hay proveedores externos configurados
                            </div>
                        }
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}