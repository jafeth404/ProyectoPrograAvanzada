@page
@model RegisterModel

@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="authentication-wrapper authentication-basic">
        <div class="authentication-inner">

            <!-- 🔥 CARD -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- 🔥 LOGO / TITULO -->
                    <div class="text-center mb-4">
                        <i class="bx bx-user-plus text-success" style="font-size: 60px;"></i>
                        <h4 class="mt-2 fw-bold">Crear Cuenta</h4>
                        <p class="text-muted">Regístrate para comenzar a usar RestauranteApp</p>
                    </div>

                    <!-- 🔥 FORM -->
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- EMAIL -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control"
                                       placeholder="correo@ejemplo.com" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control"
                                       placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <!-- CONFIRM PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                            <div class="input-group input-group-merge">
                                <span class="input-group-text"><i class="bx bx-check-shield"></i></span>
                                <input asp-for="Input.ConfirmPassword" class="form-control"
                                       placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- BOTON -->
                        <div class="mb-3">
                            <button id="registerSubmit" type="submit" class="btn btn-success w-100">
                                <i class="bx bx-user-plus me-1"></i> Crear Cuenta
                            </button>
                        </div>

                        <!-- LOGIN -->
                        <p class="text-center">
                            ¿Ya tienes cuenta?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                                Iniciar sesión
                            </a>
                        </p>

                    </form>

                    <!-- 🔥 DIVIDER -->
                    <div class="divider my-4">
                        <div class="divider-text">o regístrate con</div>
                    </div>

                    <!-- 🔥 LOGIN EXTERNO -->
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <form id="external-account"
                                  asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  method="post">

                                <div class="d-flex flex-wrap gap-2 justify-content-center">

                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit"
                                                class="btn btn-outline-success"
                                                name="provider"
                                                value="@provider.Name">

                                            <i class="bx bx-user-circle me-1"></i>
                                            @provider.DisplayName
                                        </button>
                                    }

                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center text-muted small">
                                No hay servicios externos disponibles
                            </div>
                        }
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}