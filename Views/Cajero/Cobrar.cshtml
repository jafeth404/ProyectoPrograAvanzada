@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = $"Cobrar Pedido #{Model.PedidoId}";

    decimal subtotal       = ViewBag.Subtotal;
    decimal iva            = ViewBag.Iva;
    decimal propina        = ViewBag.Propina;
    decimal empaque        = ViewBag.Empaque;
    bool    esDineIn       = ViewBag.EsDineIn;
    decimal deliveryCfg    = (decimal)(ViewBag.DeliveryConfig  ?? 0m);
    decimal deliveryRaw    = (decimal)(ViewBag.CargoDeliveryRaw ?? 0m);
    string  tipoDelivery   = (string)(ViewBag.TipoDelivery ?? "Monto");
    decimal baseTotal      = subtotal + iva + propina + empaque;
    bool    isAdmin        = (bool)(ViewBag.IsAdmin ?? false);
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h4 class="fw-bold mb-0">
            <i class="bx bx-receipt me-2 text-success"></i>Cobrar Pedido #@Model.PedidoId
        </h4>
        <p class="text-muted mb-0 small">Revise los totales antes de procesar el cobro</p>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-arrow-back me-1"></i>Volver
        </a>
    </div>
</div>

<!-- Client lookup card -->
<div class="card mb-4">
    <div class="card-header py-3">
        <h6 class="mb-0 fw-semibold"><i class="bx bx-user-search me-2"></i>Identificar Cliente</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Buscar por correo o identificación</label>
                <div class="input-group">
                    <input type="text" id="cedulaInput" class="form-control"
                           placeholder="correo@ejemplo.com o 101234567" />
                    <button class="btn btn-outline-primary" type="button" id="btnBuscarCliente">
                        <i class="bx bx-search"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Nombre del cliente</label>
                <input type="text" id="nombreCliente" class="form-control" readonly
                       placeholder="Se completará al buscar" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Crédito disponible</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input type="text" id="creditoCliente" class="form-control" readonly value="0.00" />
                </div>
            </div>
            <div class="col-md-5">
                <label class="form-label">Correo para envío de factura</label>
                <input type="email" id="emailClienteVis" class="form-control"
                       placeholder="correo@ejemplo.com" />
            </div>
        </div>
        <div id="clienteAlert" class="alert mt-2 d-none"></div>
        @if (isAdmin)
        {
            <div id="crearClienteZone" class="mt-2 d-none">
                <a href="/Usuarios/Create" target="_blank" class="btn btn-sm btn-outline-primary">
                    <i class="bx bx-user-plus me-1"></i>Crear usuario nuevo (abre en nueva pestaña)
                </a>
                <small class="text-muted ms-2">La compra no se perderá al crear el usuario.</small>
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Items table -->
    <div class="col-12 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-semibold"><i class="bx bx-list-ul me-2"></i>Detalle del Pedido</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end pe-3">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.PedidoDetalles)
                        {
                            <tr>
                                <td class="ps-3">@d.Producto?.Nombre</td>
                                <td class="text-center">@d.Cantidad</td>
                                <td class="text-end">₡@d.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end pe-3">₡@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Totals + form -->
    <div class="col-12 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-semibold"><i class="bx bx-calculator me-2"></i>Resumen de Cobro</h6>
            </div>
            <div class="card-body">
                <form asp-action="ProcesarCobro" method="post" id="cobrarForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId"      value="@Model.PedidoId" />
                    <input type="hidden" name="clienteUserId" id="formClienteUserId" />
                    <input type="hidden" name="emailCliente"  id="formEmailCliente" />

                    <!-- Totals breakdown -->
                    <div class="table-responsive mb-3">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted">Subtotal</td>
                                    <td class="text-end">₡@subtotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">IVA (13%)</td>
                                    <td class="text-end">₡@iva.ToString("N2")</td>
                                </tr>
                                @if (propina > 0)
                                {
                                    <tr>
                                        <td class="text-muted">Propina (10% dine-in)</td>
                                        <td class="text-end">₡@propina.ToString("N2")</td>
                                    </tr>
                                }
                                @if (empaque > 0)
                                {
                                    <tr>
                                        <td class="text-muted">Costo de empaque</td>
                                        <td class="text-end">₡@empaque.ToString("N2")</td>
                                    </tr>
                                }
                                @if (!esDineIn)
                                {
                                    <tr>
                                        <td class="text-muted">
                                            Delivery
                                            @if (deliveryCfg > 0)
                                            {
                                                <small class="text-info ms-1">
                                                    (cfg: @(tipoDelivery == "Porcentaje" ? $"{deliveryRaw}%" : $"₡{deliveryCfg:N2}"))
                                                </small>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <input type="number" name="costoDelivery" step="0.01" min="0"
                                                   class="form-control form-control-sm text-end"
                                                   style="width:110px" value="@deliveryCfg.ToString("F2")"
                                                   placeholder="₡0.00" />
                                        </td>
                                    </tr>
                                }
                                <tr class="border-top">
                                    <td class="fw-bold fs-6">TOTAL ESTIMADO</td>
                                    <td class="text-end fw-bold fs-6 text-success">₡@baseTotal.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" name="accion" value="facturar" class="btn btn-success">
                            <i class="bx bx-check-circle me-1"></i>Procesar Cobro
                        </button>
                        <button type="submit" name="accion" value="carrito" class="btn btn-warning">
                            <i class="bx bx-cart me-1"></i>Guardar en Carrito
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function buscarClienteLocal() {
        const termino = document.getElementById('cedulaInput').value.trim();
        const alertEl = document.getElementById('clienteAlert');
        alertEl.className = 'alert mt-2 d-none';

        if (!termino) {
            alertEl.textContent = 'Ingrese un correo o número de identificación.';
            alertEl.className   = 'alert alert-warning mt-2';
            return;
        }

        try {
            const res  = await fetch(`/Usuarios/BuscarCliente?termino=${encodeURIComponent(termino)}`);
            const data = await res.json();

            if (!data.found) {
                alertEl.textContent = 'Cliente no encontrado en el sistema.';
                alertEl.className   = 'alert alert-danger mt-2';
                document.getElementById('nombreCliente').value   = '';
                document.getElementById('creditoCliente').value  = '0.00';
                document.getElementById('emailClienteVis').value = '';
                document.getElementById('formClienteUserId').value = '';
                document.getElementById('formEmailCliente').value   = '';
                const zona = document.getElementById('crearClienteZone');
                if (zona) zona.classList.remove('d-none');
                return;
            }

            document.getElementById('nombreCliente').value       = data.nombre ?? '';
            document.getElementById('emailClienteVis').value     = data.email  ?? '';
            document.getElementById('formEmailCliente').value    = data.email  ?? '';
            document.getElementById('creditoCliente').value      = parseFloat(data.dineroDisponible ?? 0).toFixed(2);
            document.getElementById('formClienteUserId').value   = data.id;

            alertEl.textContent = `Cliente encontrado: ${data.nombre} (${data.rol})`;
            alertEl.className   = 'alert alert-success mt-2';

            const zona = document.getElementById('crearClienteZone');
            if (zona) zona.classList.add('d-none');
        } catch {
            alertEl.textContent = 'Error de conexión al buscar el cliente.';
            alertEl.className   = 'alert alert-danger mt-2';
        }
    }

    document.getElementById('btnBuscarCliente').addEventListener('click', buscarClienteLocal);
    document.getElementById('cedulaInput').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); buscarClienteLocal(); }
    });

    // Sync visible email field to the form hidden input
    document.getElementById('emailClienteVis').addEventListener('input', e => {
        document.getElementById('formEmailCliente').value = e.target.value;
    });
</script>
}
