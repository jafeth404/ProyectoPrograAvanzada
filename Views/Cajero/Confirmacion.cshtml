@model proyectoprogra.Models.Entities.Factura

@{
    ViewData["Title"] = $"Cobro Exitoso – {Model.NumeroFactura}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        <div class="card shadow-sm mb-4">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <span class="avatar avatar-lg bg-label-success rounded-circle"
                          style="width:72px;height:72px;display:inline-flex;align-items:center;justify-content:center;">
                        <i class="bx bx-check-circle fs-1 text-success"></i>
                    </span>
                </div>
                <h4 class="fw-bold mb-1">¡Cobro Procesado!</h4>
                <p class="text-muted mb-0">@Model.NumeroFactura &bull; @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>

                @if (TempData["CreditoAplicado"] != null)
                {
                    <div class="alert alert-info mt-3 mx-auto" style="max-width:400px">
                        <i class="bx bx-info-circle me-1"></i>@TempData["CreditoAplicado"]
                    </div>
                }
            </div>
        </div>

        <!-- Factura detail -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-semibold"><i class="bx bx-receipt me-2"></i>Detalle de Factura</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">P.U.</th>
                            <th class="text-end pe-3">Total línea</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fd in Model.FacturaDetalles)
                        {
                            <tr>
                                <td class="ps-3">@fd.Producto?.Nombre</td>
                                <td class="text-center">@fd.Cantidad</td>
                                <td class="text-end">₡@fd.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end pe-3">₡@fd.TotalLinea.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <div class="row justify-content-end">
                    <div class="col-auto">
                        <table class="table table-sm mb-0" style="min-width:220px">
                            <tbody>
                                <tr><td class="text-muted">Subtotal</td><td class="text-end">₡@Model.Subtotal.ToString("N2")</td></tr>
                                <tr><td class="text-muted">IVA (13%)</td><td class="text-end">₡@Model.Iva.ToString("N2")</td></tr>
                                @if (Model.Propina > 0)
                                {
                                    <tr><td class="text-muted">Propina</td><td class="text-end">₡@Model.Propina?.ToString("N2")</td></tr>
                                }
                                @if (Model.CostoEmpaque > 0)
                                {
                                    <tr><td class="text-muted">Empaque</td><td class="text-end">₡@Model.CostoEmpaque?.ToString("N2")</td></tr>
                                }
                                @if (Model.CostoDelivery > 0)
                                {
                                    <tr><td class="text-muted">Delivery</td><td class="text-end">₡@Model.CostoDelivery?.ToString("N2")</td></tr>
                                }
                                @if (Model.CreditoAplicado > 0)
                                {
                                    <tr class="text-success">
                                        <td>Crédito aplicado</td>
                                        <td class="text-end">–₡@Model.CreditoAplicado.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="border-top">
                                    <td class="fw-bold">TOTAL COBRADO</td>
                                    <td class="text-end fw-bold text-success fs-6">₡@Model.Total.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-sm-auto">
                        <a asp-action="DescargarPdf" asp-route-id="@Model.FacturaId"
                           class="btn btn-danger w-100"
                           target="_blank">
                            <i class="bx bxs-file-pdf me-1"></i>Descargar PDF
                        </a>
                    </div>

                    <div class="col-12 col-sm">
                        <div class="input-group">
                            <input type="email" id="emailEnvio" class="form-control"
                                   placeholder="correo@cliente.com" />
                            <button class="btn btn-outline-primary" id="btnEnviarEmail">
                                <i class="bx bx-send me-1"></i>Enviar por Email
                            </button>
                        </div>
                        <div id="emailFeedback" class="mt-1 small"></div>
                    </div>

                    <div class="col-12 col-sm-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bx bx-list-ul me-1"></i>Volver a Cobros
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const tokenInput = document.createElement('div');
    tokenInput.innerHTML = '@Html.AntiForgeryToken()';
    const token = tokenInput.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    document.getElementById('btnEnviarEmail').addEventListener('click', function () {
        const email = document.getElementById('emailEnvio').value.trim();
        const fb = document.getElementById('emailFeedback');

        if (!email) { fb.innerHTML = '<span class="text-danger">Ingrese un correo.</span>'; return; }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando…';

        fetch('/Cajero/EnviarEmailFactura', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ facturaId: @Model.FacturaId, email })
        })
        .then(r => r.json())
        .then(d => {
            this.disabled = false;
            this.innerHTML = '<i class="bx bx-send me-1"></i>Enviar por Email';
            fb.innerHTML = d.success
                ? '<span class="text-success"><i class="bx bx-check me-1"></i>Factura enviada correctamente.</span>'
                : `<span class="text-danger">${d.message ?? 'Error al enviar.'}</span>`;
        })
        .catch(() => {
            this.disabled = false;
            this.innerHTML = '<i class="bx bx-send me-1"></i>Enviar por Email';
            fb.innerHTML = '<span class="text-danger">Error de conexión.</span>';
        });
    });
</script>
}
