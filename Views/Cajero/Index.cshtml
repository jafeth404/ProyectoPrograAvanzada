@model IEnumerable<proyectoprogra.Models.Entities.Pedido>

@{
    ViewData["Title"] = "Cajero – Pedidos Listos para Cobro";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h4 class="fw-bold mb-0">
            <i class="bx bx-dollar-circle me-2 text-success"></i>Pedidos Listos para Cobro
        </h4>
        <p class="text-muted mb-0 small">Pedidos con todos los ítems en estado "Listo"</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bx bx-error-circle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-time fs-1 text-muted mb-3"></i>
            <h5 class="text-muted">No hay pedidos listos para cobrar en este momento.</h5>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#Pedido</th>
                        <th>Tipo</th>
                        <th>Mesa</th>
                        <th>Hora</th>
                        <th>Ítems</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-center pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var subtotal = p.PedidoDetalles.Sum(d => d.Cantidad * d.PrecioUnitario);
                        <tr>
                            <td class="ps-4 fw-bold">#@p.PedidoId</td>
                            <td>
                                <span class="badge bg-label-primary">@p.TipoPedido</span>
                            </td>
                            <td>
                                @if (p.Mesa != null)
                                {
                                    <span class="badge bg-label-info">Mesa @p.Mesa.MesaId</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-muted small">@p.Fecha.ToString("HH:mm")</td>
                            <td>
                                @foreach (var d in p.PedidoDetalles)
                                {
                                    <div class="small">@d.Producto?.Nombre × @d.Cantidad</div>
                                }
                            </td>
                            <td class="text-end fw-semibold">₡@subtotal.ToString("N2")</td>
                            <td class="text-center pe-4">
                                <a asp-action="Cobrar" asp-route-id="@p.PedidoId"
                                   class="btn btn-sm btn-success">
                                    <i class="bx bx-receipt me-1"></i>Cobrar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
