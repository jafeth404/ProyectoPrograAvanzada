@model proyectoprogra.Models.Entities.Categoria

@{
    ViewData["Title"] = "Detalle Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 TÍTULO -->
    <div class="mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-detail me-2 text-primary"></i>
            Detalle de Categoría
        </h4>
        <p class="text-muted">Información completa de la categoría seleccionada</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="card-body">

            <div class="row">

                <!-- Código -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Código</label>
                    <div class="form-control bg-light">
                        @Model.Codigo
                    </div>
                </div>

                <!-- Descripción -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Descripción</label>
                    <div class="form-control bg-light">
                        @Model.Descripcion
                    </div>
                </div>

            </div>

            <!-- 🔥 BOTONES -->
            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit" asp-route-id="@Model.CategoriaId" class="btn btn-warning">
                    <i class="bx bx-edit me-1"></i> Editar
                </a>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bx bx-arrow-back me-1"></i> Volver
                </a>

            </div>

        </div>
    </div>

</div>