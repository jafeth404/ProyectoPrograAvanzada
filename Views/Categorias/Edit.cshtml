@model proyectoprogra.Models.Entities.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 TÍTULO -->
    <div class="mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-edit-alt me-2 text-warning"></i>
            Editar Categoría
        </h4>
        <p class="text-muted">Modifica la información de la categoría</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="CategoriaId" />

                <div class="row">

                    <!-- Código -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Codigo" class="form-label fw-semibold"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: CAT001" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <input asp-for="Descripcion" class="form-control" placeholder="Ej: Bebidas, Postres..." />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                </div>

                <!-- 🔥 BOTONES -->
                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-warning">
                        <i class="bx bx-save me-1"></i> Guardar Cambios
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}