@model IEnumerable<proyectoprogra.Models.Entities.Categoria>

@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 TÍTULO + BOTÓN -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-grid-alt me-2 text-primary"></i>
            Categorías
        </h4>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus"></i> Nueva Categoría
        </a>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="table-responsive text-nowrap">

            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Codigo)</th>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody class="table-border-bottom-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Codigo</strong>
                            </td>

                            <td>@item.Descripcion</td>

                            <td class="text-center">

                                <a asp-action="Edit" asp-route-id="@item.CategoriaId"
                                   class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bx bx-edit"></i>
                                </a>

                                <a asp-action="Details" asp-route-id="@item.CategoriaId"
                                   class="btn btn-sm btn-outline-info me-1">
                                    <i class="bx bx-show"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.CategoriaId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bx bx-trash"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>