@model proyectoprogra.Models.Entities.ConfiguracionSistema

@{
    ViewData["Title"] = "Configuración del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-cog me-2 text-primary"></i>Configuración del Sistema
        </h4>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bx bx-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body pt-4">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <h6 class="fw-semibold text-uppercase text-muted small mb-3">Cargo de Delivery</h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="TipoCargoDelivery" class="form-label fw-medium">Tipo de cargo</label>
                        <select asp-for="TipoCargoDelivery" class="form-select">
                            <option value="Monto">Monto fijo (₡)</option>
                            <option value="Porcentaje">Porcentaje (%)</option>
                        </select>
                        <div class="form-text">
                            "Monto fijo" suma la cantidad exacta. "Porcentaje" aplica ese % sobre el subtotal.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CargoDelivery" class="form-label fw-medium">Valor del cargo</label>
                        <div class="input-group">
                            <span class="input-group-text" id="cargoPrefix">₡</span>
                            <input asp-for="CargoDelivery" type="number" step="0.01" min="0"
                                   class="form-control" />
                        </div>
                        <div class="form-text">
                            Ingrese el monto en colones o el porcentaje según el tipo seleccionado.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i>Guardar configuración
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const sel = document.getElementById('TipoCargoDelivery');
    const prefix = document.getElementById('cargoPrefix');
    function updatePrefix() {
        prefix.textContent = sel.value === 'Porcentaje' ? '%' : '₡';
    }
    sel.addEventListener('change', updatePrefix);
    updatePrefix();
</script>
}
