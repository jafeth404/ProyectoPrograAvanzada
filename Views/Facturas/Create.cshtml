@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Crear Factura";
}

<h2>Crear Factura</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="get" class="mb-4">
    <div class="mb-3">
        <label class="form-label">Pedido</label>
        <select name="pedidoId" class="form-control" asp-items="ViewBag.Pedidos"></select>
    </div>
    <button type="submit" class="btn btn-primary">Cargar Pedido</button>
</form>

@if (Model != null)
{
    var subtotal = Model.PedidoDetalles.Sum(d => d.Cantidad * d.PrecioUnitario);
    var iva = subtotal * 0.13m;

    <div class="card p-4 mb-4">
        <h4>Pedido #@Model.PedidoId</h4>

        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Total Línea</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in Model.PedidoDetalles)
            {
                <tr>
                    <td>@d.Producto?.Nombre</td>
                    <td>@d.Cantidad</td>
                    <td>₡@d.PrecioUnitario</td>
                    <td>₡@(d.Cantidad * d.PrecioUnitario)</td>
                </tr>
            }
            </tbody>
        </table>

        <p><strong>Subtotal:</strong> ₡@subtotal</p>
        <p><strong>IVA:</strong> ₡@iva</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />

        <div class="mb-3">
            <label class="form-label">Propina</label>
            <input type="number" step="0.01" name="propina" class="form-control" value="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">Costo Empaque</label>
            <input type="number" step="0.01" name="costoEmpaque" class="form-control" value="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">Costo Delivery</label>
            <input type="number" step="0.01" name="costoDelivery" class="form-control" value="0" />
        </div>

        <button type="submit" class="btn btn-success">Generar Factura</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
}