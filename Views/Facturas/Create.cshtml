@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Crear Factura";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <h4 class="fw-bold py-3 mb-4">
        <i class="bx bx-receipt me-2 text-primary"></i> Crear Factura
    </h4>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
    }

    <!-- Step 1: select order -->
    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0">Seleccionar Pedido</h5></div>
        <div class="card-body">
            <form asp-action="Create" method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Pedido</label>
                    <select name="pedidoId" class="form-select" asp-items="ViewBag.Pedidos"></select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bx bx-search me-1"></i> Cargar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        var subtotal       = Model.PedidoDetalles.Sum(d => d.Cantidad * d.PrecioUnitario);
        var iva            = subtotal * 0.13m;
        var esMesa         = (bool)(ViewBag.EsMesa ?? false);
        var propinaAuto    = (decimal)(ViewBag.PropinaAuto ?? 0m);
        var empaqueAuto    = (decimal)(ViewBag.CostoEmpaqueAuto ?? 0m);
        var dineroDisp     = (decimal)(ViewBag.DineroDisponible ?? 0m);
        var totalEstimado  = subtotal + iva + propinaAuto + empaqueAuto;
        var creditoEstimado = Math.Min(dineroDisp, totalEstimado);
        var totalConCredito = totalEstimado - creditoEstimado;

        <!-- Cliente: buscar en el sistema local -->
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <h5 class="mb-0">Datos del Cliente</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Buscar por correo o identificación</label>
                        <div class="input-group">
                            <input type="text" id="cedulaInput" class="form-control"
                                   placeholder="correo@ejemplo.com o 101234567" />
                            <button class="btn btn-outline-primary" type="button" id="btnBuscarCliente">
                                <i class="bx bx-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre del cliente</label>
                        <input type="text" id="nombreCliente" class="form-control" readonly
                               placeholder="Se completará al buscar" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Crédito disponible</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input type="text" id="creditoCliente" class="form-control" readonly value="0.00" />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Correo para envío de factura</label>
                        <input type="email" id="emailCliente" class="form-control"
                               placeholder="correo@ejemplo.com" />
                    </div>
                    <input type="hidden" id="clienteUserIdVal" />
                </div>
                <div id="clienteAlert" class="alert mt-2 d-none"></div>
                @if ((bool)(ViewBag.IsAdmin ?? false))
                {
                    <div id="crearClienteZone" class="mt-2 d-none">
                        <a href="/Usuarios/Create" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bx bx-user-plus me-1"></i>Crear usuario nuevo (abre en nueva pestaña)
                        </a>
                        <small class="text-muted ms-2">La compra no se perderá al crear el usuario.</small>
                    </div>
                }
            </div>
        </div>

        <!-- Hacienda: Taxpayer lookup -->
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <h5 class="mb-0">Verificación Hacienda (opcional)</h5>
                <span class="badge bg-label-primary ms-1">API Hacienda</span>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Cédula / RUC Hacienda</label>
                        <div class="input-group">
                            <input type="text" id="cedulaHacienda" class="form-control"
                                   placeholder="Ej: 101234567" maxlength="12" />
                            <button class="btn btn-outline-secondary" type="button" id="btnBuscarHacienda">
                                <i class="bx bx-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre (Hacienda)</label>
                        <input type="text" id="nombreHacienda" class="form-control" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estado Tributario</label>
                        <input type="text" id="estadoHacienda" class="form-control" readonly />
                    </div>
                </div>
                <div id="haciendaAlert" class="alert mt-2 d-none"></div>
            </div>
        </div>

        <!-- Hacienda: Exchange rate -->
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <h5 class="mb-0">Tipo de Cambio (BCCR)</h5>
                <span class="badge bg-label-info ms-1">API Hacienda</span>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <button class="btn btn-outline-info btn-sm" type="button" id="btnTipoCambio">
                            <i class="bx bx-refresh me-1"></i> Consultar
                        </button>
                    </div>
                    <div class="col-auto">
                        <span id="tipoCambioResult" class="text-muted">—</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order items -->
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <h5 class="mb-0">Pedido #@Model.PedidoId</h5>
                @if (esMesa)
                {
                    <span class="badge bg-label-primary">
                        <i class="bx bx-table me-1"></i> Mesa @Model.Mesa?.NumeroMesa
                    </span>
                }
                else
                {
                    <span class="badge bg-label-warning">
                        <i class="bx bx-box me-1"></i> Para llevar / Delivery
                    </span>
                }
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Total Línea</th>
                            <th>Empaque</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.PedidoDetalles)
                        {
                            var stockOk = d.Producto?.Stock >= d.Cantidad;
                            <tr class="@(!stockOk ? "table-danger" : "")">
                                <td>@d.Producto?.Nombre</td>
                                <td>@d.Cantidad</td>
                                <td>₡@d.PrecioUnitario.ToString("N2")</td>
                                <td>₡@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                <td>
                                    @if (!esMesa && (d.Producto?.RequiereEmpaque ?? false))
                                    {
                                        <span class="badge bg-label-info">
                                            ₡@((d.Producto!.CostoEmpaque ?? 0).ToString("N2")) × @d.Cantidad
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (stockOk)
                                    {
                                        <span class="badge bg-label-success">@d.Producto?.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-danger">
                                            Insuf. (@d.Producto?.Stock disp.)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Totals breakdown -->
                <div class="mt-3 ms-auto" style="max-width:380px;">
                    <table class="table table-sm table-borderless text-end">
                        <tr>
                            <td class="text-muted">Subtotal</td>
                            <td class="fw-semibold">₡@subtotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">IVA (13%)</td>
                            <td class="fw-semibold">₡@iva.ToString("N2")</td>
                        </tr>
                        @if (esMesa)
                        {
                            <tr class="text-primary">
                                <td><i class="bx bx-coin me-1"></i>Propina automática (10%)</td>
                                <td class="fw-semibold">₡@propinaAuto.ToString("N2")</td>
                            </tr>
                        }
                        @if (!esMesa && empaqueAuto > 0)
                        {
                            <tr class="text-info">
                                <td><i class="bx bx-box me-1"></i>Empaque automático</td>
                                <td class="fw-semibold">₡@empaqueAuto.ToString("N2")</td>
                            </tr>
                        }
                        @if (dineroDisp > 0)
                        {
                            <tr class="text-success">
                                <td><i class="bx bx-wallet me-1"></i>Crédito disponible</td>
                                <td class="fw-semibold">₡@dineroDisp.ToString("N2")</td>
                            </tr>
                            <tr class="text-success">
                                <td><i class="bx bx-minus-circle me-1"></i>Crédito a aplicar</td>
                                <td class="fw-semibold">− ₡@creditoEstimado.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="border-top">
                            <td class="fw-bold">Total estimado</td>
                            <td class="fw-bold fs-5">₡@totalConCredito.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Generate form -->
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Cargos adicionales</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                    <input type="hidden" name="emailCliente" id="emailClienteHidden" />
                    <input type="hidden" name="clienteUserId" id="formClienteUserId" />

                    <div class="row g-3">

                        @if (esMesa)
                        {
                            <div class="col-md-4">
                                <label class="form-label">
                                    Propina (10% automático)
                                    <span class="badge bg-label-primary ms-1">Automático</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input type="text" class="form-control bg-light"
                                           value="@propinaAuto.ToString("N2")" readonly />
                                </div>
                                <small class="text-muted">Calculada automáticamente para pedidos en mesa</small>
                            </div>
                        }

                        @if (!esMesa)
                        {
                            <div class="col-md-4">
                                <label class="form-label">
                                    Costo Empaque
                                    <span class="badge bg-label-info ms-1">Automático</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input type="text" class="form-control bg-light"
                                           value="@empaqueAuto.ToString("N2")" readonly />
                                </div>
                                <small class="text-muted">Calculado según productos que requieren empaque</small>
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label">
                                Costo Delivery
                                @{
                                    var tipoDelivery = (string)(ViewBag.TipoDelivery ?? "Monto");
                                    var deliveryCfg  = (decimal)(ViewBag.DeliveryConfig ?? 0m);
                                    var deliveryRaw  = (decimal)(ViewBag.CargoDeliveryRaw ?? 0m);
                                }
                                @if (deliveryCfg > 0)
                                {
                                    <span class="badge bg-label-info ms-1">
                                        Config: @(tipoDelivery == "Porcentaje" ? $"{deliveryRaw}%" : $"₡{deliveryCfg:N2}")
                                    </span>
                                }
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" step="0.01" min="0" name="costoDelivery"
                                       class="form-control" value="@deliveryCfg.ToString("F2")" />
                            </div>
                            <small class="text-muted">Editable si necesita ajustar</small>
                        </div>

                        @if (dineroDisp > 0)
                        {
                            <div class="col-12">
                                <div class="alert alert-success d-flex align-items-center">
                                    <i class="bx bx-wallet fs-4 me-2"></i>
                                    <div>
                                        <strong>Crédito disponible: ₡@dineroDisp.ToString("N2")</strong><br/>
                                        <small>
                                            Se aplicarán ₡@creditoEstimado.ToString("N2") automáticamente al facturar.
                                            @if (dineroDisp > totalEstimado)
                                            {
                                                <span>Restará ₡@((dineroDisp - totalEstimado).ToString("N2")) en su saldo.</span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <button type="submit" name="accion" value="facturar" class="btn btn-success">
                            <i class="bx bx-check me-1"></i> Generar Factura
                        </button>
                        <button type="submit" name="accion" value="carrito" class="btn btn-warning">
                            <i class="bx bx-cart me-1"></i> Guardar en Carrito
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    }

</div>

@section Scripts {
<script>
    // ── Local DB client search ───────────────────────────────────────
    async function buscarClienteLocal() {
        const termino = document.getElementById('cedulaInput').value.trim();
        const alertEl = document.getElementById('clienteAlert');
        alertEl.className = 'alert mt-2 d-none';

        if (!termino) {
            alertEl.textContent = 'Ingrese un correo o número de identificación.';
            alertEl.className = 'alert alert-warning mt-2';
            return;
        }

        try {
            const res  = await fetch(`/Usuarios/BuscarCliente?termino=${encodeURIComponent(termino)}`);
            const data = await res.json();

            if (!data.found) {
                alertEl.textContent = 'Cliente no encontrado en el sistema.';
                alertEl.className = 'alert alert-danger mt-2';
                document.getElementById('nombreCliente').value = '';
                document.getElementById('creditoCliente').value = '0.00';
                document.getElementById('emailCliente').value = '';
                document.getElementById('clienteUserIdVal').value = '';
                document.getElementById('formClienteUserId').value = '';
                const zona = document.getElementById('crearClienteZone');
                if (zona) zona.classList.remove('d-none');
                return;
            }

            document.getElementById('nombreCliente').value   = data.nombre ?? '';
            document.getElementById('emailCliente').value    = data.email  ?? '';
            document.getElementById('emailClienteHidden').value = data.email ?? '';
            document.getElementById('creditoCliente').value  = parseFloat(data.dineroDisponible ?? 0).toFixed(2);
            document.getElementById('clienteUserIdVal').value  = data.id;
            document.getElementById('formClienteUserId').value = data.id;

            alertEl.textContent = `Cliente encontrado: ${data.nombre} (${data.rol})`;
            alertEl.className   = 'alert alert-success mt-2';

            const zona = document.getElementById('crearClienteZone');
            if (zona) zona.classList.add('d-none');
        } catch {
            alertEl.textContent = 'Error de conexión al buscar el cliente.';
            alertEl.className   = 'alert alert-danger mt-2';
        }
    }

    document.getElementById('btnBuscarCliente').addEventListener('click', buscarClienteLocal);
    document.getElementById('cedulaInput').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); buscarClienteLocal(); }
    });

    // ── Sync email field into hidden POST input ──────────────────────
    document.getElementById('emailCliente').addEventListener('input', e => {
        document.getElementById('emailClienteHidden').value = e.target.value;
    });

    // ── Hacienda taxpayer lookup ─────────────────────────────────────
    async function buscarHacienda() {
        const cedula  = document.getElementById('cedulaHacienda').value.trim();
        const alertEl = document.getElementById('haciendaAlert');
        alertEl.className = 'alert mt-2 d-none';

        if (!cedula) {
            alertEl.textContent = 'Ingrese una cédula o RUC.';
            alertEl.className   = 'alert alert-warning mt-2';
            return;
        }

        try {
            const res  = await fetch(`/api/hacienda/contribuyente?id=${encodeURIComponent(cedula)}`);
            const data = await res.json();

            if (!res.ok) {
                alertEl.textContent = data.error ?? 'No encontrado en Hacienda.';
                alertEl.className   = 'alert alert-danger mt-2';
                document.getElementById('nombreHacienda').value = '';
                document.getElementById('estadoHacienda').value = '';
                return;
            }

            document.getElementById('nombreHacienda').value = data.nombre ?? '';
            document.getElementById('estadoHacienda').value = data.estado ?? '—';

            if (data.moroso || data.omiso) {
                alertEl.textContent = 'Contribuyente con situación irregular (moroso/omiso).';
                alertEl.className   = 'alert alert-warning mt-2';
            }
        } catch {
            alertEl.textContent = 'Error de conexión con la API de Hacienda.';
            alertEl.className   = 'alert alert-danger mt-2';
        }
    }

    document.getElementById('btnBuscarHacienda').addEventListener('click', buscarHacienda);
    document.getElementById('cedulaHacienda').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); buscarHacienda(); }
    });

    // ── Exchange rate ────────────────────────────────────────────────
    document.getElementById('btnTipoCambio').addEventListener('click', async () => {
        const el = document.getElementById('tipoCambioResult');
        el.textContent = 'Consultando...';
        try {
            const res  = await fetch('/api/hacienda/tipocambio');
            const data = await res.json();
            if (res.ok) {
                el.textContent =
                    `Compra: ₡${data.compra.toFixed(2)}  /  Venta: ₡${data.venta.toFixed(2)}` +
                    `  (${data.fecha})`;
            } else {
                el.textContent = data.error ?? 'Error';
            }
        } catch {
            el.textContent = 'Error de conexión.';
        }
    });
</script>
}
