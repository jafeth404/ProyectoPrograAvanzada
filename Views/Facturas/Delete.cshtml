@model proyectoprogra.Models.Entities.Factura

<h2>Eliminar Factura</h2>

<p>¿Seguro que quieres eliminar la factura @Model.NumeroFactura?</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="FacturaId" />
    <button class="btn btn-danger">Eliminar</button>
    <a asp-action="Index">Cancelar</a>
</form>