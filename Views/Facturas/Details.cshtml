@model proyectoprogra.Models.Entities.Factura

<h2>Factura #@Model.NumeroFactura</h2>

<p><strong>Fecha:</strong> @Model.Fecha</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.FacturaDetalles)
        {
            <tr>
                <td>@d.Producto.Nombre</td>
                <td>@d.Cantidad</td>
                <td>@d.PrecioUnitario</td>
                <td>@d.TotalLinea</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<p><strong>Subtotal:</strong> ₡@Model.Subtotal</p>
<p><strong>IVA (13%):</strong> ₡@Model.Iva</p>
<p><strong>Total:</strong> ₡@Model.Total</p>

<div class="mt-4 d-flex gap-2">

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Volver
    </a>

    <a asp-action="Edit" asp-route-id="@Model.FacturaId" class="btn btn-warning">
        ✏️ Editar
    </a>

    <a asp-action="Delete" asp-route-id="@Model.FacturaId" class="btn btn-danger">
    🗑 Eliminar
</a>
</div>