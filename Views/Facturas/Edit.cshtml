@model proyectoprogra.Models.Entities.Factura

<h2>Editar Factura</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="FacturaId" />

    <div class="mb-3">
        <label>Propina</label>
        <input asp-for="Propina" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Costo Empaque</label>
        <input asp-for="CostoEmpaque" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Costo Delivery</label>
        <input asp-for="CostoDelivery" class="form-control" />
    </div>

    <button class="btn btn-primary">Guardar</button>
</form>