@model IEnumerable<proyectoprogra.Models.Entities.Factura>

@{
    ViewData["Title"] = "Facturas";
}

<h2>Facturas</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-success">Nueva Factura</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Pedido</th>
            <th>Fecha</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.NumeroFactura</td>
            <td>@f.PedidoId</td>
            <td>@f.Fecha</td>
            <td>₡@f.Total</td>
            <td>
                <a asp-action="Details" asp-route-id="@f.FacturaId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@f.FacturaId" class="btn btn-sm btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@f.FacturaId" class="btn btn-sm btn-danger">Delete</a>
                    <a asp-action="Pdf" asp-route-id="@f.FacturaId"
                           class="btn btn-danger btn-sm">
                        PDF
                    </a>
            </td>
        </tr>
    }
    </tbody>
</table>