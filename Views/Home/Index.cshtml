@{
    ViewData["Title"] = "Dashboard";
}

@using System.Text.Json

<div class="container-xxl flex-grow-1 container-p-y">

    <h4 class="fw-bold py-3 mb-4">
        <i class="bx bx-home-alt me-2"></i> Dashboard
    </h4>

    <!-- 🔥 CARDS -->
    <div class="row">

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold d-block mb-1">Productos</span>
                        <h3 class="card-title mb-0">@ViewBag.TotalProductos</h3>
                    </div>
                    <i class="bx bx-package text-primary fs-1"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold d-block mb-1">Pedidos</span>
                        <h3 class="card-title mb-0">@ViewBag.TotalPedidos</h3>
                    </div>
                    <i class="bx bx-cart-alt text-success fs-1"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold d-block mb-1">Mesas</span>
                        <h3 class="card-title mb-0">@ViewBag.TotalMesas</h3>
                    </div>
                    <i class="bx bx-chair text-warning fs-1"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- 📊 GRÁFICO DE VENTAS -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <h5 class="card-header fw-bold">
                    <i class="bx bx-line-chart me-2 text-primary"></i>
                    Ventas por día
                </h5>
                <div class="card-body">
                    <div id="ventasChart"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- 🔥 SCRIPTS -->
<script src="/sneat/assets/vendor/libs/apex-charts/apexcharts.js"></script>

<script>
    var labels = @Html.Raw(JsonSerializer.Serialize(ViewBag.VentasLabels ?? new List<string>()));
    var data = @Html.Raw(JsonSerializer.Serialize(ViewBag.VentasData ?? new List<decimal>()));

    var options = {
        chart: {
            type: 'area',
            height: 350,
            toolbar: { show: false }
        },
        series: [{
            name: 'Ventas',
            data: data
        }],
        xaxis: {
            categories: labels
        },
        stroke: {
            curve: 'smooth',
            width: 3
        },
        colors: ['#696cff'],
        fill: {
            type: 'gradient',
            gradient: {
                shade: 'light',
                type: "vertical",
                opacityFrom: 0.5,
                opacityTo: 0.1
            }
        },
        dataLabels: {
            enabled: false
        },
        grid: {
            borderColor: '#e7e7e7'
        }
    };

    new ApexCharts(document.querySelector("#ventasChart"), options).render();
</script>