@model proyectoprogra.Models.Entities.Mesa

@{
    ViewData["Title"] = "Eliminar Mesa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="mb-4">
        <h4 class="fw-bold text-danger">
            <i class="bx bx-trash me-2"></i>
            Eliminar Mesa
        </h4>
        <p class="text-muted">Esta acción no se puede deshacer</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card border-danger">
        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bx bx-shield-x fs-4 me-2"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <!-- ⚠️ ALERTA -->
            <div class="alert alert-danger d-flex align-items-center">
                <i class="bx bx-error-circle fs-4 me-2"></i>
                ¿Seguro que deseas eliminar esta mesa?
            </div>

            <!-- 📋 DATOS -->
            <div class="row">

                <!-- Número -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Mesa</label>
                    <div class="form-control bg-light">
                        <span class="badge bg-label-primary fs-6">
                            Mesa @Model.NumeroMesa
                        </span>
                    </div>
                </div>

                <!-- Capacidad -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Capacidad</label>
                    <div class="form-control bg-light">
                        <i class="bx bx-user me-1"></i>
                        @Model.Capacidad personas
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">

                        @if (Model.Estado == "Disponible")
                        {
                            <span class="badge bg-label-success">Disponible</span>
                        }
                        else if (Model.Estado == "Ocupada")
                        {
                            <span class="badge bg-label-danger">Ocupada</span>
                        }
                        else
                        {
                            <span class="badge bg-label-warning">@Model.Estado</span>
                        }

                    </div>
                </div>

            </div>

            <!-- 🔥 BOTONES -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="MesaId" />

                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Eliminar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>