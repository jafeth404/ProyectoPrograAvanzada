@model proyectoprogra.Models.Entities.Mesa

@{
    ViewData["Title"] = "Detalle Mesa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold">
                <i class="bx bx-table me-2 text-primary"></i>
                Detalle de la Mesa
            </h4>
            <p class="text-muted mb-0">Información completa de la mesa</p>
        </div>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.MesaId" class="btn btn-warning me-2">
                <i class="bx bx-edit me-1"></i> Editar
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="card-body">

            <div class="row">

                <!-- Número de mesa -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Mesa</label>
                    <div class="form-control bg-light">
                        <span class="badge bg-label-primary fs-6">
                            Mesa @Model.NumeroMesa
                        </span>
                    </div>
                </div>

                <!-- Capacidad -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Capacidad</label>
                    <div class="form-control bg-light">
                        <i class="bx bx-user me-1"></i>
                        @Model.Capacidad personas
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">

                        @if (Model.Estado == "Disponible")
                        {
                            <span class="badge bg-label-success">Disponible</span>
                        }
                        else if (Model.Estado == "Ocupada")
                        {
                            <span class="badge bg-label-danger">Ocupada</span>
                        }
                        else if (Model.Estado == "Reservada")
                        {
                            <span class="badge bg-label-warning">Reservada</span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">@Model.Estado</span>
                        }

                    </div>
                </div>

            </div>

        </div>
    </div>

</div>