@model IEnumerable<proyectoprogra.Models.Entities.Factura>

@{
    ViewData["Title"] = "Mi Historial de Compras";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h4 class="fw-bold mb-0">
            <i class="bx bx-history me-2 text-primary"></i>Mi Historial de Compras
        </h4>
        <p class="text-muted mb-0 small">Todas sus facturas anteriores</p>
    </div>
    <div class="col-auto">
        <a asp-action="MisDatos" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-user me-1"></i>Mis Datos
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-receipt fs-1 text-muted mb-3"></i>
            <h5 class="text-muted">Aún no tiene compras registradas.</h5>
            <a asp-controller="Pedidos" asp-action="Create" class="btn btn-primary mt-2">
                Hacer mi primer pedido
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var f in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold">@f.NumeroFactura</span>
                            <span class="text-muted small ms-2">@f.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            @if (f.Reversada)
                            {
                                <span class="badge bg-label-danger">Reversada</span>
                            }
                            <span class="fw-bold text-success fs-6">₡@f.Total.ToString("N2")</span>
                            <a asp-controller="Facturas" asp-action="Pdf" asp-route-id="@f.FacturaId"
                               class="btn btn-sm btn-outline-danger" target="_blank">
                                <i class="bx bxs-file-pdf me-1"></i>PDF
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">P.U.</th>
                                    <th class="text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in f.FacturaDetalles)
                                {
                                    <tr>
                                        <td class="ps-3">@d.Producto?.Nombre</td>
                                        <td class="text-center">@d.Cantidad</td>
                                        <td class="text-end">₡@d.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end pe-3">₡@d.TotalLinea.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer">
                        <div class="row justify-content-end text-sm">
                            <div class="col-auto">
                                <span class="text-muted me-3">Subtotal: ₡@f.Subtotal.ToString("N2")</span>
                                <span class="text-muted me-3">IVA: ₡@f.Iva.ToString("N2")</span>
                                @if (f.Propina > 0)
                                {
                                    <span class="text-muted me-3">Propina: ₡@f.Propina?.ToString("N2")</span>
                                }
                                @if (f.CreditoAplicado > 0)
                                {
                                    <span class="text-success me-3">Crédito: –₡@f.CreditoAplicado.ToString("N2")</span>
                                }
                                <span class="fw-bold text-success">Total: ₡@f.Total.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
