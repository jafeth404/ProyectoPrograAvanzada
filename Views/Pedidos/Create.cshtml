@{
    ViewData["Title"] = "Crear Pedido";
}

<h1>Crear Pedido</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post" id="pedidoForm">

    <div class="card p-4 mb-4">

        <div class="mb-3">
            <label>Tipo Pedido</label>
            <select name="TipoPedido" id="TipoPedido" class="form-control" required>
                <option value="">— Seleccione —</option>
                @if (!User.IsInRole("Usuario") || User.IsInRole("Administrador"))
                {
                    <option value="Dine-in">Dine-in (Mesa)</option>
                }
                <option value="Takeout">Para llevar (Takeout)</option>
                <option value="Delivery">Delivery</option>
            </select>
        </div>

        <div class="mb-3" id="mesaRow" style="display:none">
            <label>Mesa</label>
            <select name="MesaId" class="form-control" asp-items="ViewBag.MesaId"></select>
        </div>

        @if (!User.IsInRole("Usuario") || User.IsInRole("Administrador"))
        {
            <div class="mb-3">
                <label>Estado</label>
                <select name="Estado" class="form-control">
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Completo">Completo</option>
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="Estado" value="Pendiente" />
        }

    </div>

    <!-- AGREGAR PRODUCTOS -->
    <div class="card p-4 mb-4">
        <h4>Agregar Producto</h4>

        <div class="row">
            <div class="col-md-5">
                <select id="productoSelect" class="form-control">
                    <option value="" disabled selected>Seleccione producto</option>
                    @foreach (var p in ViewBag.Productos)
                    {
                        <option value="@p.ProductoId" data-precio="@p.Precio">
                            @p.Nombre (@p.Precio)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <input type="number" id="cantidadInput" class="form-control" placeholder="Cantidad" min="1" step="1" />
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-primary" onclick="agregarProducto()">Agregar</button>
            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card p-4">
        <h4>Detalle del Pedido</h4>

        <table class="table" id="detalleTable">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <input type="hidden" id="ItemsJson" name="ItemsJson" value="[]" />

    <button type="submit" class="btn btn-success mt-3">Guardar Pedido</button>
</form>

<script>
let items = [];

function agregarProducto() {
    const select = document.getElementById("productoSelect");
    const cantidadRaw = document.getElementById("cantidadInput").value.trim();
    const cantidad = parseInt(cantidadRaw, 10);

    if (!select.value) {
        alert("Seleccione un producto.");
        return;
    }
    if (!cantidadRaw || isNaN(cantidad) || cantidad < 1) {
        alert("La cantidad debe ser un número entero mayor o igual a 1.");
        return;
    }

    const id = parseInt(select.value);
    const nombre = select.options[select.selectedIndex].text;
    const precio = parseFloat(select.options[select.selectedIndex].dataset.precio);

    items.push({
        ProductoId: id,
        nombre: nombre,
        precio: precio,
        Cantidad: cantidad
    });

    renderTabla();

    select.value = "";
    document.getElementById("cantidadInput").value = "";
}

function eliminarItem(index) {
    items.splice(index, 1);
    renderTabla();
}

function renderTabla() {
    const tbody = document.querySelector("#detalleTable tbody");
    tbody.innerHTML = "";

    items.forEach((item, index) => {
        const total = item.precio * item.Cantidad;

        tbody.innerHTML += `
            <tr>
                <td>${item.nombre}</td>
                <td>${item.Cantidad}</td>
                <td>${item.precio}</td>
                <td>${total}</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarItem(${index})">X</button>
                </td>
            </tr>
        `;
    });
}

function beforeSubmit() {
    if (items.length === 0) {
        alert("Debe agregar al menos un producto");
        return false;
    }

    document.getElementById("ItemsJson").value = JSON.stringify(items);
    return true;
}
document.getElementById("pedidoForm").addEventListener("submit", function (e) {
    if (items.length === 0) {
        alert("Debe agregar al menos un producto");
        e.preventDefault();
        return;
    }
    document.getElementById("ItemsJson").value = JSON.stringify(items);
});

// Show/hide mesa selector based on order type
document.getElementById("TipoPedido").addEventListener("change", function () {
    document.getElementById("mesaRow").style.display =
        this.value === "Dine-in" ? "" : "none";
});
</script>