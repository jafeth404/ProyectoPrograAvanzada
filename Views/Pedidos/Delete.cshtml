@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar Pedido</h1>

<div class="card p-4 mb-4">
    <h4>¿Seguro que quieres eliminar este pedido?</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tipo Pedido</dt>
        <dd class="col-sm-9">@Model.TipoPedido</dd>

        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.Fecha</dd>

        <dt class="col-sm-3">Mesa</dt>
        <dd class="col-sm-9">@Model.Mesa?.MesaId</dd>
    </dl>
</div>

<div class="card p-4 mb-3">
    <h5>Detalle del Pedido</h5>

    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.PedidoDetalles)
        {
            <tr>
                <td>@item.Producto.Nombre</td>
                <td>@item.Cantidad</td>
                <td>@item.PrecioUnitario</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="PedidoId" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>