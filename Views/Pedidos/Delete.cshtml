@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Eliminar Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="mb-4">
        <h4 class="fw-bold text-danger">
            <i class="bx bx-trash me-2"></i>
            Eliminar Pedido
        </h4>
        <p class="text-muted">Esta acción no se puede deshacer</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card border-danger">
        <div class="card-body">

            <!-- ⚠️ ALERTA -->
            <div class="alert alert-danger d-flex align-items-center">
                <i class="bx bx-error-circle fs-4 me-2"></i>
                ¿Seguro que deseas eliminar este pedido?
            </div>

            <!-- 📋 DATOS -->
            <div class="row">

                <!-- Tipo -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <div class="form-control bg-light">
                        @if (Model.TipoPedido == "Mesa")
                        {
                            <span class="badge bg-label-primary">
                                <i class="bx bx-table"></i> Mesa
                            </span>
                        }
                        else if (Model.TipoPedido == "Delivery")
                        {
                            <span class="badge bg-label-info">
                                <i class="bx bx-truck"></i> Delivery
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">
                                <i class="bx bx-package"></i> Pickup
                            </span>
                        }
                    </div>
                </div>

                <!-- Fecha -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Fecha</label>
                    <div class="form-control bg-light">
                        <i class="bx bx-calendar me-1"></i>
                        @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">

                        @if (Model.Estado == "Pendiente")
                        {
                            <span class="badge bg-label-warning">Pendiente</span>
                        }
                        else if (Model.Estado == "EnProceso")
                        {
                            <span class="badge bg-label-info">En Proceso</span>
                        }
                        else if (Model.Estado == "Completado")
                        {
                            <span class="badge bg-label-success">Completado</span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">@Model.Estado</span>
                        }

                    </div>
                </div>

                <!-- Mesa -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Mesa</label>
                    <div class="form-control bg-light">
                        @if (Model.Mesa != null)
                        {
                            <span class="badge bg-label-primary">
                                Mesa @Model.Mesa.NumeroMesa
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Sin mesa</span>
                        }
                    </div>
                </div>

            </div>

            <!-- 🔥 BOTONES -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="PedidoId" />

                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Eliminar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>