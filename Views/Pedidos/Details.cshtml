@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles del Pedido</h1>

<div class="card p-4 mb-4">
    <h4>Información</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tipo Pedido</dt>
        <dd class="col-sm-9">@Model.TipoPedido</dd>

        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.Fecha</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>

        <dt class="col-sm-3">Mesa</dt>
        <dd class="col-sm-9">@Model.Mesa?.MesaId</dd>
    </dl>
</div>

<div class="card p-4">
    <h4>Detalle del Pedido</h4>
    <hr />

    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.PedidoDetalles)
        {
            <tr>
                <td>@item.Producto.Nombre</td>
                <td>@item.Cantidad</td>
                <td>@item.PrecioUnitario</td>
                <td>@(item.Cantidad * item.PrecioUnitario)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.PedidoId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>