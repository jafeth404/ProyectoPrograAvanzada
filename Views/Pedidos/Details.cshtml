@model proyectoprogra.Models.Entities.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-receipt me-2 text-primary"></i>
            Detalle del Pedido
        </h4>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.PedidoId" class="btn btn-warning me-2">
                <i class="bx bx-edit"></i> Editar
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back"></i> Volver
            </a>
        </div>
    </div>

    <!-- 🔥 INFO PRINCIPAL -->
    <div class="card mb-4">
        <div class="card-body">

            <div class="row">

                <!-- Tipo -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <div class="form-control bg-light">

                        @if (Model.TipoPedido == "Mesa")
                        {
                            <span class="badge bg-label-primary">
                                <i class="bx bx-table"></i> Mesa
                            </span>
                        }
                        else if (Model.TipoPedido == "Delivery")
                        {
                            <span class="badge bg-label-info">
                                <i class="bx bx-truck"></i> Delivery
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">
                                <i class="bx bx-package"></i> Pickup
                            </span>
                        }

                    </div>
                </div>

                <!-- Fecha -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Fecha</label>
                    <div class="form-control bg-light">
                        <i class="bx bx-calendar me-1"></i>
                        @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">

                        @if (Model.Estado == "Pendiente")
                        {
                            <span class="badge bg-label-warning">Pendiente</span>
                        }
                        else if (Model.Estado == "EnProceso")
                        {
                            <span class="badge bg-label-info">En Proceso</span>
                        }
                        else if (Model.Estado == "Completado")
                        {
                            <span class="badge bg-label-success">Completado</span>
                        }
                        else if (Model.Estado == "Cancelado")
                        {
                            <span class="badge bg-label-danger">Cancelado</span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">@Model.Estado</span>
                        }

                    </div>
                </div>

                <!-- Mesa -->
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Mesa</label>
                    <div class="form-control bg-light">

                        @if (Model.Mesa != null)
                        {
                            <span class="badge bg-label-primary">
                                <i class="bx bx-table"></i> Mesa @Model.Mesa.NumeroMesa
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Sin mesa</span>
                        }

                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- 🔥 DETALLE DE PRODUCTOS -->
    @if (Model.PedidoDetalles != null && Model.PedidoDetalles.Any())
    {
        <div class="card">
            <h5 class="card-header">
                <i class="bx bx-list-ul me-2"></i>
                Productos del Pedido
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PedidoDetalles)
                        {
                            <tr>
                                <!-- Producto -->
                                <td>
                                    <strong>@item.Producto?.Nombre</strong>
                                </td>

                                <!-- Cantidad -->
                                <td>
                                    <span class="badge bg-label-info">
                                        @item.Cantidad
                                    </span>
                                </td>

                                <!-- Precio Unitario -->
                                <td>
                                    ₡ @item.PrecioUnitario.ToString("N2")
                                </td>

                                <!-- Total -->
                                <td>
                                    ₡ @(item.Cantidad* item.PrecioUnitario).ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 🔥 TOTAL GENERAL -->
        <div class="card mt-3">
            <div class="card-body text-end">
                <h5 class="mb-0">
                    Total Pedido:
                    <span class="text-success fw-bold">
                        ₡ @Model.PedidoDetalles.Sum(x => x.Cantidad * x.PrecioUnitario).ToString("N2")
                    </span>
                </h5>
            </div>
        </div>
    }
    else
    {
        <!-- 🟡 SIN PRODUCTOS -->
        <div class="card">
            <div class="card-body text-center text-muted">
                <i class="bx bx-info-circle fs-2"></i>
                <p class="mt-2 mb-0">Este pedido no tiene productos registrados</p>
            </div>
        </div>
    }

</div>