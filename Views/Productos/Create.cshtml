@model proyectoprogra.Models.Entities.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 TÍTULO -->
    <div class="mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-plus-circle me-2 text-primary"></i>
            Nuevo Producto
        </h4>
        <p class="text-muted">Completa la información del producto</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">

                    <!-- Código -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Codigo" class="form-label fw-semibold"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: PROD001" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <!-- Nombre -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- Categoría -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="CategoriaId" class="form-label fw-semibold"></label>
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                            <option value="">Seleccione una categoría</option>
                        </select>
                    </div>

                </div>

                <div class="row">

                    <!-- Precio -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="Precio" class="form-label fw-semibold"></label>
                        <input asp-for="Precio" class="form-control" placeholder="₡ 0.00" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>

                    <!-- Stock -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold"></label>
                        <input asp-for="Stock" class="form-control" placeholder="Cantidad disponible" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>

                    <!-- Costo Empaque -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="CostoEmpaque" class="form-label fw-semibold"></label>
                        <input asp-for="CostoEmpaque" class="form-control" placeholder="₡ 0.00" />
                        <span asp-validation-for="CostoEmpaque" class="text-danger"></span>
                    </div>

                    <!-- Switches -->
                    <div class="col-md-3 d-flex flex-column justify-content-center">

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" asp-for="RequiereEmpaque" id="chkEmpaque" />
                            <label class="form-check-label" for="chkEmpaque">
                                Requiere Empaque
                            </label>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="Activo" />
                            <label class="form-check-label">
                                Activo
                            </label>
                        </div>

                    </div>

                </div>

                <!-- 🔥 BOTONES -->
                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> Guardar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}