@model proyectoprogra.Models.Entities.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 TÍTULO -->
    <div class="mb-4">
        <h4 class="fw-bold text-danger">
            <i class="bx bx-trash me-2"></i>
            Eliminar Producto
        </h4>
        <p class="text-muted">Esta acción no se puede deshacer</p>
    </div>

    <!-- 🔥 CARD -->
    <div class="card border-danger">
        <div class="card-body">

            <!-- ⚠️ ALERTA -->
            <div class="alert alert-danger d-flex align-items-center">
                <i class="bx bx-error-circle fs-4 me-2"></i>
                ¿Seguro que deseas eliminar este producto?
            </div>

            <!-- 📋 DATOS -->
            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Código</label>
                    <div class="form-control bg-light">@Model.Codigo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Nombre</label>
                    <div class="form-control bg-light">@Model.Nombre</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Categoría</label>
                    <div class="form-control bg-light">
                        @Model.Categoria?.Descripcion
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Precio</label>
                    <div class="form-control bg-light">
                        ₡ @Model.Precio.ToString("N2")
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Stock</label>
                    <div class="form-control bg-light">@Model.Stock</div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Empaque</label>
                    <div class="form-control bg-light">
                        @if (Model.RequiereEmpaque)
                        {
                            <span>
                                Sí (₡ @(Model.CostoEmpaque?.ToString("N2") ?? "0.00"))
                            </span>
                        }
                        else
                        {
                            <span>No</span>
                        }
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">
                        @(Model.Activo ? "Activo" : "Inactivo")
                    </div>
                </div>

            </div>

            <!-- 🔥 BOTONES -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="ProductoId" />

                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Eliminar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>