@model IEnumerable<proyectoprogra.Models.Entities.Producto>

@{
    ViewData["Title"] = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-package me-2 text-primary"></i>
            Productos
        </h4>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus"></i> Nuevo Producto
        </a>
    </div>

    <!-- 🔥 CARD -->
    <div class="card">
        <div class="table-responsive text-nowrap">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Empaque</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Categoría</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- Código -->
                            <td>
                                <span class="badge bg-label-primary">@item.Codigo</span>
                            </td>

                            <!-- Nombre -->
                            <td>
                                <strong>@item.Nombre</strong>
                            </td>

                            <!-- Precio -->
                            <td>
                                ₡ @item.Precio.ToString("N2")
                            </td>

                            <!-- Empaque -->
                            <td>
                                @if (item.RequiereEmpaque)
                                {
                                    <span class="badge bg-label-info">
                                        Sí (₡ @(item.CostoEmpaque?.ToString("N2") ?? "0.00"))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">No</span>
                                }
                            </td>

                            <!-- Stock -->
                            <td>
                                @if (item.Stock > 10)
                                {
                                    <span class="badge bg-label-success">@item.Stock</span>
                                }
                                else if (item.Stock > 0)
                                {
                                    <span class="badge bg-label-warning">@item.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-danger">0</span>
                                }
                            </td>

                            <!-- Estado -->
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-label-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-danger">Inactivo</span>
                                }
                            </td>

                            <!-- Categoría -->
                            <td>
                                @item.Categoria?.Descripcion
                            </td>

                            <!-- Acciones -->
                            <td class="text-center">

                                <a asp-action="Edit" asp-route-id="@item.ProductoId"
                                   class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bx bx-edit"></i>
                                </a>

                                <a asp-action="Details" asp-route-id="@item.ProductoId"
                                   class="btn btn-sm btn-outline-info me-1">
                                    <i class="bx bx-show"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.ProductoId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bx bx-trash"></i>
                                </a>

                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>