@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- 🔥 HEADER -->
    <div class="text-center mb-5">
        <i class="bx bx-error-circle text-danger" style="font-size: 80px;"></i>
        <h2 class="fw-bold text-danger mt-3">Oops... Algo salió mal</h2>
        <p class="text-muted">
            Ocurrió un error mientras procesábamos tu solicitud.
        </p>
    </div>

    <!-- 🔥 CARD ERROR -->
    <div class="card border-danger shadow-sm">
        <div class="card-body text-center">

            <h5 class="text-danger fw-semibold mb-3">
                <i class="bx bx-bug me-2"></i>
                Error del sistema
            </h5>

            <p class="text-muted">
                Puedes intentar nuevamente o regresar al inicio.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-warning mt-3">
                    <strong>ID del error:</strong>
                    <code>@Model.RequestId</code>
                </div>
            }

            <!-- BOTONES -->
            <div class="mt-4 d-flex justify-content-center gap-2">

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bx bx-home me-1"></i> Ir al Inicio
                </a>

                <button onclick="location.reload()" class="btn btn-outline-secondary">
                    <i class="bx bx-refresh"></i> Reintentar
                </button>

            </div>

        </div>
    </div>

    <!-- 🔥 INFO DEV (SOLO LOCAL) -->
    <div class="card mt-4">
        <div class="card-body">

            <h6 class="fw-bold">
                <i class="bx bx-code-alt me-2 text-primary"></i>
                Información técnica (solo desarrollo)
            </h6>

            <p class="text-muted mb-2">
                En modo desarrollo puedes ver más detalles del error.
            </p>

            <div class="alert alert-info">
                Activa el entorno <strong>Development</strong> para depurar errores.
            </div>

        </div>
    </div>

</div>