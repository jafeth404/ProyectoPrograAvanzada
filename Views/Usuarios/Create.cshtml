@model proyectoprogra.Models.ViewModels.CrearUsuarioVM

@{
    ViewData["Title"] = "Nuevo Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold">
            <i class="bx bx-user-plus me-2 text-primary"></i>
            Nuevo Usuario
        </h4>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i> Volver
        </a>
    </div>

    <div class="card">
        <div class="card-body pt-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <!-- Información básica -->
                <h6 class="fw-semibold text-uppercase text-muted small mb-3">Información básica</h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-medium">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="usuario@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Identificacion" class="form-label fw-medium">Identificación</label>
                        <input asp-for="Identificacion" class="form-control" placeholder="000000000" />
                        <span asp-validation-for="Identificacion" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NombreCompleto" class="form-label fw-medium">Nombre completo</label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Juan Pérez" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Genero" class="form-label fw-medium">Género</label>
                        <select asp-for="Genero" class="form-select">
                            <option value="No especifica">No especifica</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Genero" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Rol y contraseña -->
                <h6 class="fw-semibold text-uppercase text-muted small mb-3">Rol y acceso</h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Rol" class="form-label fw-medium">Rol</label>
                        <select asp-for="Rol" id="rolSelect" class="form-select">
                            @foreach (var r in ViewBag.Roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="passwordField" style="display:none;">
                        <label asp-for="Password" class="form-label fw-medium">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="autoPassInfo" style="display:none;">
                        <div class="alert alert-info mb-0 py-2">
                            <i class="bx bx-info-circle me-2"></i>
                            Se generará una contraseña automática. Se mostrará al crear el usuario.
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Datos de tarjeta (opcionales para personal interno) -->
                <h6 class="fw-semibold text-uppercase text-muted small mb-3">
                    Datos de tarjeta <span class="text-muted fw-normal">(opcional para personal interno)</span>
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="TipoTarjeta" class="form-label fw-medium">Tipo de tarjeta</label>
                        <select asp-for="TipoTarjeta" class="form-select">
                            <option value="N/A">N/A</option>
                            <option value="Visa">Visa</option>
                            <option value="MasterCard">MasterCard</option>
                            <option value="American Express">American Express</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NumeroTarjeta" class="form-label fw-medium">Número de tarjeta</label>
                        <input asp-for="NumeroTarjeta" class="form-control" placeholder="XXXX-XXXX-XXXX-XXXX" />
                        <div class="form-text">Solo se almacenarán los últimos 4 dígitos.</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-user-plus me-1"></i> Crear Usuario
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>

</div>

<script>
    (function () {
        var rolSelect = document.getElementById('rolSelect');
        var passwordField = document.getElementById('passwordField');
        var autoPassInfo = document.getElementById('autoPassInfo');

        function togglePassword() {
            var esUsuario = rolSelect.value === 'Usuario';
            passwordField.style.display = esUsuario ? 'block' : 'none';
            autoPassInfo.style.display = esUsuario ? 'none' : 'block';
        }

        rolSelect.addEventListener('change', togglePassword);
        togglePassword();
    })();
</script>
