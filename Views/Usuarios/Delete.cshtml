@model proyectoprogra.Models.ApplicationUser

@{
    ViewData["Title"] = "Eliminar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="mb-4">
        <h4 class="fw-bold text-danger">
            <i class="bx bx-trash me-2"></i>
            Eliminar Usuario
        </h4>
        <p class="text-muted">Esta acción desactivará al usuario del sistema</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="bx bx-shield-x fs-4 me-2"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="card border-danger">
        <div class="card-body">

            <div class="alert alert-danger d-flex align-items-center">
                <i class="bx bx-error-circle fs-4 me-2"></i>
                ¿Seguro que deseas desactivar este usuario?
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <div class="form-control bg-light">@Model.Email</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Nombre</label>
                    <div class="form-control bg-light">@Model.NombreCompleto</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-control bg-light">
                        @if (Model.Activo)
                        {
                            <span class="badge bg-label-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-label-danger">Inactivo</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Ha iniciado sesión</label>
                    <div class="form-control bg-light">
                        @if (Model.HaIniciadoSesion)
                        {
                            <span class="badge bg-label-warning">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">No</span>
                        }
                    </div>
                </div>

            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Desactivar usuario
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-arrow-back me-1"></i> Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>
